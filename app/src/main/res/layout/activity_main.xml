<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#080808">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SECURITY PRO ULTRA"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#00FF66"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Advanced Cyber Security &amp; Header Auditor"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <EditText
        android:id="@+id/inputDomain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Target Domain (e.g., github.com)"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:backgroundTint="#00FF66"
        android:padding="12dp"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btnLoopholeCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EXECUTE ADVANCED AUDIT"
        android:backgroundTint="#00FF66"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginTop="12dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#121212"
        android:padding="4dp">

        <TextView
            android:id="@+id/txtResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Ready] Awaiting target input for deep diagnostic scan..."
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="10dp"/>
    </ScrollView>

</LinearLayout>
